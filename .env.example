# Copy to .env and change values if needed: cp .env.example .env
# Never commit .env. The stack also starts without it: every value below
# is the default used in docker-compose.yml.

# --- Project warehouse (postgres service) ---
POSTGRES_DB=water_quality  # database name created on first start
POSTGRES_USER=wq_user     # database user created on first start
POSTGRES_PASSWORD=change_me # password for POSTGRES_USER (change beyond local use)
POSTGRES_PORT=5432   # port on YOUR machine; inside Docker it is always 5432
POSTGRES_HOST=postgres  # warehouse host name; inside Docker always "postgres"

# --- Pipeline ---
PIPELINE_MODE=snapshot  # snapshot = fixed, reproducible inputs
DATA_DIR=/opt/project/data  # data folder inside the containers
CONFIG_DIR=/opt/project/config  # config folder inside the containers

# --- Airflow ---
AIRFLOW_UID=50000  # container user ID; on Linux use the output of: id -u
AIRFLOW_ADMIN_USER=admin  # Airflow UI login (http://localhost:8080)
AIRFLOW_ADMIN_PASSWORD=change_me # Airflow UI password (change beyond local use)
FERNET_KEY=    # encrypts saved connections; blank = unencrypted (fine locally)
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret  # signs Airflow's internal API tokens
AIRFLOW__API_AUTH__JWT_ISSUER=airflow  # issuer name for those tokens