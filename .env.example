@'
# Copy to .env and fill in. Never commit .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=water_quality
POSTGRES_USER=wq_user
POSTGRES_PASSWORD=change_me

DATA_DIR=/opt/project/data
CONFIG_DIR=/opt/project/config

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
'@ | Set-Content -Encoding ascii .env.example